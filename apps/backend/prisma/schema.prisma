  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([profissional])
  @@index([empresa])
  @@index([crea])
  @@index([cpfCnpj])
  @@index([status])
  @@map("controle_anuidades")
}

/// Controle de pagamentos de ART's / Protocolos (módulo Licitações).
model ControlePagamentoArt {
  id               String    @id @default(cuid())
  uf               String?
  empresa          String?
  contratante      String?
  cnpjCpf          String?
  contrato         String?
  observacoes      String?
  vigenciaInicio   DateTime?
  vigenciaTermino  DateTime?
  renovacao        DateTime?
  art              String?
  valor            Decimal?  @db.Decimal(14, 2)
  profissional     String
  vencDoBoleto     DateTime?
  status           String    @default("EM_ABERTA")
  pago             String?
  solicitaEm       DateTime?
  pagoEm           DateTime?
  fluig            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([uf])
  @@index([empresa])
  @@index([contratante])
  @@index([cnpjCpf])
  @@index([contrato])
  @@index([art])
  @@index([profissional])
  @@index([status])
  @@map("controle_pagamentos_art")
}

/// Receitas dos consórcios BSB/HUB (página Financeiro → Receitas).
model ReceitaFinanceira {
  id                 String   @id @default(cuid())
  consorcio          String // bsb | hub
  mes                String
  nf                 String
  faturamento        Decimal? @db.Decimal(15, 2)
  recebimentoLiquido Decimal? @db.Decimal(15, 2)
  status             String
  statusData         String?
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([consorcio])
  @@index([consorcio, mes])
  @@index([status])
