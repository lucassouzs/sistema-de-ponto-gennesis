  messages      Message[]

  @@index([chatId])
  @@index([chatId, lastMessageAt])
  @@index([chatId, isPinned, sortOrder])
  @@index([createdById])
  @@map("chat_topics")
}

// Modelo de Mensagens dentro de um Chat
model Message {
  id              String            @id @default(cuid())
  chatId          String            // Chat ao qual pertence
  senderId        String            // Quem enviou (ou quem realizou a aÃ§Ã£o, nas mensagens de sistema)
  content         String            // ConteÃºdo da mensagem
  isSystem        Boolean           @default(false) // Eventos de grupo/fixar/etc. â exibidos como texto centralizado
  isRead          Boolean           @default(false)
  readAt          DateTime?         // Quando foi lida
  editedAt        DateTime?         // Ãltima ediÃ§Ã£o (texto)
  deletedAt       DateTime?         // Soft delete: mensagem apagada pelo remetente
  
  // Anexos
  attachments MessageAttachment[]

  // Auditoria
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  /// Mensagem citada (resposta estilo WhatsApp)
  replyToId       String?
  replyTo         Message?          @relation("MessageReplyThread", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[]         @relation("MessageReplyThread")

  /// TÃ³pico da conversa (null = mensagem geral, legado)
  topicId         String?
  topic           ChatTopic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)

  // Relacionamentos
  chat            Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender          User              @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  favorites       MessageFavorite[]
  pinnedInChats   Chat[]            @relation("ChatPinnedMessage")
  hiddenForUsers  MessageHiddenForUser[]
  
  @@index([chatId])
  @@index([senderId])
  @@index([isRead])
  @@index([createdAt])
  @@index([replyToId])
  @@index([topicId])
  @@index([chatId, topicId])
  @@map("messages")
}

