  paymentBoletoPhaseReleased Boolean             @default(false)
  /// Comprovante de pagamento anexado na fase Pagamento
  paymentProofUrl            String?
  paymentProofName           String?
  /// Notas fiscais anexadas apÃ³s validaÃ§Ã£o do comprovante: [{ url, name, uploadedAt, number }]
  nfAttachments              Json?
  /// Frete informado na criaÃ§Ã£o (ou ediÃ§Ã£o em correÃ§Ã£o). Total a pagar = soma dos itens + frete.
  freightAmount              Decimal             @default(0) @db.Decimal(15, 2)
  amountToPay                Decimal?            @db.Decimal(15, 2) // Itens + frete (recalculado ao salvar itens/frete)
  notes                      String?
  /// [{ url, name }] â anexos gerais na criaÃ§Ã£o da OC
  attachments                Json?
  createdBy                  String // UsuÃ¡rio que criou
