  updatedAt DateTime @updatedAt

  gasStations FuelGasStation[]
  requests    FuelRefuelRequest[]

  @@index([isActive])
  @@index([stateCode])
  @@map("fuel_administrative_regions")
}

/// Posto de combustível vinculado a uma cidade satélite (código em fuelSatelliteCities).
model FuelGasStation {
  id            String   @id @default(cuid())
  displayNumber Int      @unique
  cityCode      String
  name          String
  address       String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  /// Legado — regiões antigas no banco; novos postos usam apenas cityCode.
  regionId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  region   FuelAdministrativeRegion? @relation(fields: [regionId], references: [id], onDelete: SetNull)
  requests FuelRefuelRequest[]

  @@index([cityCode])
  @@index([regionId])
  @@index([isActive])
  @@map("fuel_gas_stations")
}

/// Solicitação de abastecimento de combustível (espelho do AppSheet tb solicitAbast).
model FuelRefuelRequest {
  id            String @id @default(cuid())
  displayNumber Int    @unique

  requesterId String
  requester   User   @relation("FuelRefuelRequester", fields: [requesterId], references: [id], onDelete: Restrict)

  requestedAt DateTime @default(now())
  refuelDate  DateTime
  route       String
  /// Código da cidade satélite (lista fixa em fuelSatelliteCities).
  satelliteCityCode      String?
  administrativeRegionId String?
  administrativeRegion   FuelAdministrativeRegion? @relation(fields: [administrativeRegionId], references: [id], onDelete: SetNull)
  gasStationId           String?
  gasStation             FuelGasStation? @relation(fields: [gasStationId], references: [id], onDelete: SetNull)
  costCenter  String?
  contractId  String?
  contract    Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)

  driverName         String
  vehiclePlate       String
  vehicleDescription String?
  /// Particular → aprovação do gestor; frota/empresa → fila direta do Suprimentos.
  vehicleType        FuelVehicleType?

  dashboardPhotoUrl  String?
  dashboardPhotoKey  String?
  dashboardPhotoName String?

  observations String?
  status       FuelRefuelRequestStatus @default(PENDING_MANAGER)
  sourceChatId String?
  sourceWhatsAppPhone String?

  managerApprovedBy      String?
  managerApprovedAt      DateTime?
  managerApprovalComment String?
  managerRejectionReason String?

  suppliesApprovedBy      String?
  suppliesApprovedAt      DateTime?
  suppliesApprovalComment String?
  suppliesRejectionReason String?
  /// Prazo para o solicitante realizar o abastecimento após liberação do Suprimentos
  refuelDeadlineAt        DateTime?
  refuelDeadlineAmount    Int?
  refuelDeadlineUnit      FuelRefuelDeadlineUnit?

  refuelReportedAt        DateTime?
  odometerKm              Int?
  tankLevelAfter          FuelTankLevelAfter?
  refuelReportObservations String?
  receiptPhotoUrl         String?
  receiptPhotoKey         String?
  receiptPhotoName        String?
  litersRefueled          Decimal? @db.Decimal(10, 3)
  pricePerLiter           Decimal? @db.Decimal(10, 2)

  managerApprover User? @relation("FuelRefuelManager", fields: [managerApprovedBy], references: [id], onDelete: SetNull)
  suppliesApprover User? @relation("FuelRefuelSupplies", fields: [suppliesApprovedBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId])
  @@index([contractId])
  @@index([satelliteCityCode])
  @@index([administrativeRegionId])
  @@index([gasStationId])
  @@index([status])
  @@index([refuelDate])
  @@map("fuel_refuel_requests")
}

enum LogisticsDeliveryUrgency {
  NORMAL
  URGENT
}

enum LogisticsDeliveryRequestStatus {
  PENDING
  COMPLETED
}

enum LogisticsDeliveryOutcome {
  DELIVERED
  PARTIAL
  NOT_DELIVERED
}

