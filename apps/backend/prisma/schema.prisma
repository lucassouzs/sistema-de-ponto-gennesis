// Modelo de Chat/Conversa entre Setores
model Chat {
  id                  String          @id @default(cuid())
  chatType            ChatType        @default(DEPARTMENT)
  initiatorId         String          // Quem iniciou a conversa
  groupName           String?         // Nome do grupo (para tipo GROUP)
  groupDescription    String?         // DescriÃ§Ã£o do grupo (opcional)
  groupAvatarUrl      String?         // Avatar do grupo (opcional)
  recipientDepartment String?         // Setor destinatÃ¡rio (para tipo DEPARTMENT)
  recipientId         String?         // UsuÃ¡rio destinatÃ¡rio (para tipo DIRECT)
  status              ChatStatus      @default(PENDING) // PENDING, ACCEPTED, CLOSED
  acceptedBy          String?         // Quem aceitou a conversa
  acceptedAt          DateTime?       // Quando foi aceita
  closedBy            String?         // Quem encerrou
  closedAt            DateTime?       // Quando foi encerrada
  lastMessageAt       DateTime?       // Ãltima mensagem enviada
  pinnedMessageId     String?         // Mensagem fixada no topo
  /// Quando `chatType` = GROUP_CALL: conversa âsalaâ da chamada nativa (histÃ³rico fora do grupo).
  parentGroupChatId   String?
  /// ID da sessÃ£o WebRTC (mesmo valor de `callId`) para correlacionar.
  groupCallSessionId  String?
  
  // Mensagens da conversa
  messages            Message[]
  participants        ChatParticipant[]
  
  // Relacionamentos
  initiator           User            @relation("ChatInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  accepter            User?           @relation("ChatAccepter", fields: [acceptedBy], references: [id], onDelete: SetNull)
  closer              User?           @relation("ChatCloser", fields: [closedBy], references: [id], onDelete: SetNull)
  recipient           User?           @relation("ChatRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  pinnedMessage       Message?        @relation("ChatPinnedMessage", fields: [pinnedMessageId], references: [id], onDelete: SetNull)
  userPrivacySettings ChatUserPrivacy[]
  parentGroupChat     Chat?           @relation("GroupCallSideChat", fields: [parentGroupChatId], references: [id], onDelete: SetNull)
  groupCallSideChats  Chat[]          @relation("GroupCallSideChat")
  topics              ChatTopic[]
  
  @@index([initiatorId])
  @@index([recipientDepartment])
  @@index([recipientId])
  @@index([chatType])
  @@index([groupName])
  @@index([status])
  @@index([lastMessageAt])
  @@index([parentGroupChatId])
  @@index([groupCallSessionId])
  @@map("chats")
}

model ChatParticipant {
  id        String   @id @default(cuid())
  chatId    String
  userId    String
  isAdmin   Boolean  @default(false)
