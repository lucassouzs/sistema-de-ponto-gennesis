  logisticsDeliveryRequests LogisticsDeliveryRequest[]
  invoiceNumbers    PurchaseOrderInvoiceNumber[]
  comments          PurchaseOrderComment[]

  @@index([orderNumber])
  @@index([materialRequestId])
  @@index([quoteMapId])
  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
  @@map("purchase_orders")
