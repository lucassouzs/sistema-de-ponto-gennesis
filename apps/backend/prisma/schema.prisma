// Modelo de Solicitação DP (específico do AppSheet “Solicitações Departamento Pessoal”)
model DpRequest {
  id            String @id @default(cuid())
  /// Número legível sequencial (1, 2, 3…) para exibição e busca.
  displayNumber Int    @unique

  // Solicitante
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Dados do formulário
  urgency           DpRequestUrgency @default(MEDIUM)
  requestType       DpRequestType
  title             String
  sectorSolicitante String
  solicitanteNome   String
  solicitanteEmail  String

  prazoInicio DateTime
  prazoFim    DateTime

  /// Campos específicos por tipo (JSON validado na API).
  details Json?

  // Dados vinculados ao contrato/centro de custo (pode ser persistido para histórico mesmo que contrato mude).
  contractId   String?
  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  company      String?
  polo         String?

  // Workflow
  status        DpRequestStatus @default(WAITING_MANAGER)
  /// Linha do tempo: [{ "at": ISO-8601, "status": "IN_FINANCEIRO" }, ...] — cada mudança de etapa.
  statusHistory Json            @default("[]")

  // Aprovação do gestor
  managerApprovedBy       String?
  managerApprovedAt       DateTime?
  managerApprovalComment  String?
  managerRejectionReason  String?
  managerRejectionComment String?
  // (MVP) sem relação explícita com User: mantemos só o userId em managerApprovedBy.

  // Feedback do DP
  dpFeedback             String?
  dpFeedbackAt           DateTime?
  /// Nome ou observação do responsável pela ação (registro no fluxo).
  dpResponsibleNote      String?
  requesterReturnComment String?
  requesterReturnedAt    DateTime?
  dpConclusionComment    String?
  dpConcludedAt          DateTime?
  /// Motivo informado pelo DP ao cancelar a solicitação.
  dpCancellationReason   String?
  dpHandledBy            String?
  // (MVP) sem relação explícita com User: mantemos só o userId em dpHandledBy.

  // Metadados
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([costCenterId])
  @@map("dp_requests")
}

// Modelo de Feriados
model Holiday {
  id          String      @id @default(cuid())
  name        String // Nome do feriado
  date        DateTime // Data do feriado
  type        HolidayType @default(NATIONAL) // Tipo de feriado
  isRecurring Boolean     @default(false) // Se é recorrente (todos os anos)
  state       String? // Estado (para feriados estaduais)
  city        String? // Cidade (para feriados municipais)
  description String? // Descrição adicional
  isActive    Boolean     @default(true) // Se está ativo
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdBy   String? // ID do usuário que criou

  @@unique([date, name]) // Evita duplicatas
  @@index([date])
  @@index([type])
  @@index([isRecurring])
  @@map("holidays")
}

enum HolidayType {
  NATIONAL // Feriado nacional
  STATE // Feriado estadual
  MUNICIPAL // Feriado municipal
  OPTIONAL // Ponto facultativo
  COMPANY // Feriado da empresa
}

// Modelo de Chat/Conversa entre Setores
model Chat {
  id                  String          @id @default(cuid())
  chatType            ChatType        @default(DEPARTMENT)
  initiatorId         String          // Quem iniciou a conversa
  groupName           String?         // Nome do grupo (para tipo GROUP)
  groupDescription    String?         // Descrição do grupo (opcional)
  groupAvatarUrl      String?         // Avatar do grupo (opcional)
  recipientDepartment String?         // Setor destinatário (para tipo DEPARTMENT)
  recipientId         String?         // Usuário destinatário (para tipo DIRECT)
  status              ChatStatus      @default(PENDING) // PENDING, ACCEPTED, CLOSED
  acceptedBy          String?         // Quem aceitou a conversa
  acceptedAt          DateTime?       // Quando foi aceita
  closedBy            String?         // Quem encerrou
  closedAt            DateTime?       // Quando foi encerrada
  lastMessageAt       DateTime?       // Última mensagem enviada
  pinnedMessageId     String?         // Mensagem fixada no topo
  /// Quando `chatType` = GROUP_CALL: conversa “sala” da chamada nativa (histórico fora do grupo).
  parentGroupChatId   String?
  /// ID da sessão WebRTC (mesmo valor de `callId`) para correlacionar.
  groupCallSessionId  String?
  
  // Mensagens da conversa
  messages            Message[]
  participants        ChatParticipant[]
  
  // Relacionamentos
  initiator           User            @relation("ChatInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  accepter            User?           @relation("ChatAccepter", fields: [acceptedBy], references: [id], onDelete: SetNull)
  closer              User?           @relation("ChatCloser", fields: [closedBy], references: [id], onDelete: SetNull)
  recipient           User?           @relation("ChatRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  pinnedMessage       Message?        @relation("ChatPinnedMessage", fields: [pinnedMessageId], references: [id], onDelete: SetNull)
  userPrivacySettings ChatUserPrivacy[]
  parentGroupChat     Chat?           @relation("GroupCallSideChat", fields: [parentGroupChatId], references: [id], onDelete: SetNull)
  groupCallSideChats  Chat[]          @relation("GroupCallSideChat")
  topics              ChatTopic[]
  
  @@index([initiatorId])
  @@index([recipientDepartment])
  @@index([recipientId])
  @@index([chatType])
  @@index([groupName])
  @@index([status])
  @@index([lastMessageAt])
  @@index([parentGroupChatId])
  @@index([groupCallSessionId])
  @@map("chats")
}

model ChatParticipant {
  id        String   @id @default(cuid())
  chatId    String
  userId    String
  isAdmin   Boolean  @default(false)
  joinedAt  DateTime @default(now())

  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([chatId])
  @@index([userId])
  @@map("chat_participants")
}

/// Tópico dentro de uma conversa (estilo threads do ChatGPT)
model ChatTopic {
  id            String    @id @default(cuid())
  chatId        String
  title         String
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?
  isPinned      Boolean   @default(false)
  sortOrder     Int       @default(0)

  chat          Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  createdBy     User      @relation("ChatTopicCreator", fields: [createdById], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([chatId])
  @@index([chatId, lastMessageAt])
  @@index([chatId, isPinned, sortOrder])
  @@index([createdById])
  @@map("chat_topics")
}

// Modelo de Mensagens dentro de um Chat
model Message {
  id              String            @id @default(cuid())
  chatId          String            // Chat ao qual pertence
  senderId        String            // Quem enviou (ou quem realizou a ação, nas mensagens de sistema)
  content         String            // Conteúdo da mensagem
  isSystem        Boolean           @default(false) // Eventos de grupo/fixar/etc. — exibidos como texto centralizado
  isRead          Boolean           @default(false)
  readAt          DateTime?         // Quando foi lida
  editedAt        DateTime?         // Última edição (texto)
  deletedAt       DateTime?         // Soft delete: mensagem apagada pelo remetente
  
  // Anexos
  attachments MessageAttachment[]

  // Auditoria
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  /// Mensagem citada (resposta estilo WhatsApp)
  replyToId       String?
  replyTo         Message?          @relation("MessageReplyThread", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[]         @relation("MessageReplyThread")

  /// Tópico da conversa (null = mensagem geral, legado)
  topicId         String?
  topic           ChatTopic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)

  // Relacionamentos
  chat            Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender          User              @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  favorites       MessageFavorite[]
  pinnedInChats   Chat[]            @relation("ChatPinnedMessage")
  hiddenForUsers  MessageHiddenForUser[]
  
  @@index([chatId])
  @@index([senderId])
  @@index([isRead])
  @@index([createdAt])
  @@index([replyToId])
  @@index([topicId])
  @@index([chatId, topicId])
  @@map("messages")
}

// Favoritar mensagem (por usuário; cada um tem seus favoritos)
model MessageFavorite {
  id         String   @id @default(cuid())
  userId     String
  messageId  String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId])
  @@index([messageId])
  @@map("message_favorites")
}

/// Limpar conversa "só pra mim" (estilo WhatsApp): oculta mensagens com createdAt <= clearedAt
model ChatUserPrivacy {
  id        String    @id @default(cuid())
  userId    String
  chatId    String
  clearedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([userId, chatId])
  @@index([userId])
  @@index([chatId])
  @@map("chat_user_privacy")
}

/// Apagar mensagem "só pra mim" — oculta no histórico deste usuário apenas
model MessageHiddenForUser {
  id        String   @id @default(cuid())
  userId    String
  messageId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId])
  @@index([messageId])
  @@map("message_hidden_for_user")
}

// Modelo de Anexos de Mensagens
model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  fileName  String // Nome original do arquivo
  fileUrl   String? // URL do arquivo no S3
  fileKey   String? // Chave do arquivo no S3
  fileSize  Int? // Tamanho em bytes
  mimeType  String? // Tipo MIME do arquivo
  createdAt DateTime @default(now())

  // Relacionamento
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

enum ChatStatus {
  PENDING // Aguardando aceitação
  ACCEPTED // Aceito e ativo
  CLOSED // Encerrado
}

enum ChatType {
  DEPARTMENT  // Chat com setor (modelo antigo)
  DIRECT      // Chat direto entre usuários (estilo WhatsApp)
  GROUP       // Chat em grupo
  GROUP_CALL  // Sala temporária da chamada nativa em grupo (mensagens de chamada + chat paralelo)
}

// Modelo de Status da Folha de Pagamento
model PayrollStatus {
  id          String    @id @default(cuid())
  month       Int // Mês (1-12)
  year        Int // Ano
  isFinalized Boolean   @default(false) // Se a folha foi finalizada pelo DP
  finalizedBy String? // ID do usuário que finalizou
  finalizedAt DateTime? // Data/hora da finalização
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relacionamentos
  finalizedByUser User? @relation("PayrollFinalizer", fields: [finalizedBy], references: [id], onDelete: SetNull)

  // Índice único para mês/ano
  @@unique([month, year])
  @@index([month, year])
  @@index([isFinalized])
  @@map("payroll_status")
}

// Modelo de Centro de Custo de Engenharia
model CostCenter {
