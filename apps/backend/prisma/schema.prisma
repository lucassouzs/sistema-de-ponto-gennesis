  numeroProcesso       String
  tribunal             String?
  vara                 String?
  reclamante           String
  dataAudiencia        String?
  horario              String?
  presencial           String?
  statusProcesso       String?
  decisaoStf           String?
  polo                 String?
  empresa              String?
  objeto               String?  @db.Text
  objeto2              String?  @db.Text
  contrato             String?
  funcao               String?
  regimeContratacao    String?
  periodo              String?
  periodoInicio        String?
  periodoFim           String?
  representanteAutor   String?
  acordo               String?
  valorCausa           Decimal? @db.Decimal(14, 2)
  statusSentenca       String?
  valorSentenca        Decimal? @db.Decimal(14, 2)
  valorRO              Decimal? @db.Decimal(14, 2)
  valorRR              Decimal? @db.Decimal(14, 2)
  valorCustas          Decimal? @db.Decimal(14, 2)
  valorAcordo          Decimal? @db.Decimal(14, 2)
  valorPagoSentenciado Decimal? @db.Decimal(14, 2)
  valorParcela         Decimal? @db.Decimal(14, 2)
  valorPago            Decimal? @db.Decimal(14, 2)
  numParcelas          Int?
  custas               Decimal? @db.Decimal(14, 2)
  previdencia          Decimal? @db.Decimal(14, 2)
