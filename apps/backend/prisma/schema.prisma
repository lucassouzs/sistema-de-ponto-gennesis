// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de UsuÃ¡rio
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String
  cpf          String   @unique
  role         UserRole @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  isFirstLogin Boolean  @default(true)
  /// URL pÃºblica ou relativa (/uploads/...) da foto de perfil
  profilePhotoUrl  String?
  /// Chave no S3 (quando usar armazenamento em nuvem)
  profilePhotoKey  String?
  /// Ãltimo login bem-sucedido
  lastLoginAt       DateTime?
  /// Ãltima atividade observada (page view / heartbeat)
  lastSeenAt        DateTime?
  lastActivityPath  String?
  lastActivityLabel String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relacionamentos
  employee     Employee?
  loginEvents  UserLoginEvent[]
  pageVisits   UserPageVisit[]
  timeRecords  TimeRecord[]
  vacations    Vacation[]
  overtime     Overtime[]
  reports      Report[]
  medicalCertificates MedicalCertificate[]
  approvedCertificates MedicalCertificate[] @relation("CertificateApprover")
  salaryAdjustments SalaryAdjustment[]
  salaryDiscounts   SalaryDiscount[]
  pointCorrectionRequests PointCorrectionRequest[] @relation("PointCorrectionApprover")
  pointCorrectionComments PointCorrectionComment[]
  sentMessages      Message[]                       @relation("MessageSender")
  initiatedChats    Chat[]                          @relation("ChatInitiator")
  acceptedChats     Chat[]                          @relation("ChatAccepter")
  closedChats       Chat[]                          @relation("ChatCloser")
  receivedChats     Chat[]                          @relation("ChatRecipient")
  chatParticipants  ChatParticipant[]
  chatTopicsCreated ChatTopic[]                     @relation("ChatTopicCreator")
  finalizedPayrolls PayrollStatus[]                 @relation("PayrollFinalizer")
  materialRequestsRequested MaterialRequest[]       @relation("MaterialRequestRequester")
  materialRequestsApproved  MaterialRequest[]       @relation("MaterialRequestApprover")
  materialRequestsRejected   MaterialRequest[]      @relation("MaterialRequestRejecter")
  chatGPTConversations      ChatGPTConversation[]
  passwordResetTokens PasswordResetToken[]
  purchaseOrdersCreated          PurchaseOrder[] @relation("PurchaseOrderCreator")
  purchaseOrdersApproved         PurchaseOrder[] @relation("PurchaseOrderApprover")
  purchaseOrdersComprasApproved  PurchaseOrder[] @relation("PurchaseOrderComprasApprover")
  purchaseOrdersGestorApproved   PurchaseOrder[] @relation("PurchaseOrderGestorApprover")
  quoteMapsCreated          QuoteMap[]             @relation("QuoteMapCreator")
  userPermissions           UserPermission[]       @relation("UserPermissionUser")
  updatedPermissions        UserPermission[]       @relation("UserPermissionUpdatedBy")
  userContractPermissions   UserContractPermission[] @relation("UserContractPermissionUser")
  updatedContractPermissions UserContractPermission[] @relation("UserContractPermissionUpdatedBy")
  userDpApprovalContracts    UserDpApprovalContract[] @relation("UserDpApprovalContractUser")
  updatedDpApprovalContracts UserDpApprovalContract[] @relation("UserDpApprovalContractUpdatedBy")
  stockMovements            StockMovement[]
  stockShortfallsResolved   StockShortfall[] @relation("StockShortfallResolver")
  driveFolders              DriveFolder[]            @relation("DriveFolderOwner")
  driveFiles                DriveFile[]              @relation("DriveFileOwner")
  driveFolderShares         DriveFolderShare[]       @relation("DriveFolderShareUser")
  driveFolderSharesCreated  DriveFolderShare[]       @relation("DriveFolderShareCreatedBy")
  messageFavorites         MessageFavorite[]
  chatUserPrivacy          ChatUserPrivacy[]
  messageHiddenForUser     MessageHiddenForUser[]
  extratoCaixaFiltrosSalvos ExtratoCaixaFiltroSalvo[]
  kanbanBoardsCreated      KanbanBoard[]          @relation("KanbanBoardCreator")
  kanbanBoardShares        KanbanBoardShare[]     @relation("KanbanBoardShareUser")
  kanbanBoardSharesCreated KanbanBoardShare[]     @relation("KanbanBoardShareCreatedBy")
  kanbanCardsAssigned      KanbanCard[]           @relation("KanbanCardAssignee")
  kanbanCardMemberships    KanbanCardMember[]     @relation("KanbanCardMemberUser")
  kanbanCardComments       KanbanCardComment[]    @relation("KanbanCardCommentAuthor")
  kanbanCardAttachments    KanbanCardAttachment[] @relation("KanbanCardAttachmentUploader")
  kanbanChecklistAssigned  KanbanChecklistItem[]  @relation("KanbanChecklistAssignee")
  plannerEvents            PlannerEvent[]         @relation("PlannerEventOwner")
  plannerEventAttendances  PlannerEventAttendee[] @relation("PlannerEventAttendeeUser")
  plannerTasks             PlannerTask[]          @relation("PlannerTaskOwner")
  plannerTaskLists         PlannerTaskList[]      @relation("PlannerTaskListOwner")
  plannerAgendaSharesOwned     PlannerAgendaShare[] @relation("PlannerAgendaShareOwner")
  plannerAgendaSharesReceived  PlannerAgendaShare[] @relation("PlannerAgendaShareSharedWith")
  plannerAgendaSharesCreated   PlannerAgendaShare[] @relation("PlannerAgendaShareCreatedBy")
  googleCalendarConnection GoogleCalendarConnection? @relation("GoogleCalendarConnectionUser")
  demandSheetApprovalsCreated       DemandSheetApproval[] @relation("DemandSheetApprovalCreator")
  demandSheetApprovalsAsSolicitante DemandSheetApproval[] @relation("DemandSheetApprovalSolicitante")
  demandSheetApprovalsManagerApproved DemandSheetApproval[] @relation("DemandSheetApprovalManager")
  demandSheetApprovalsPurchaseStatusUpdated DemandSheetApproval[] @relation("DemandSheetApprovalPurchaseStatusUpdater")
  materialDeliveriesCreated               MaterialDelivery[] @relation("MaterialDeliveryCreator")
  materialDeliveriesReceived              MaterialDelivery[] @relation("MaterialDeliveryReceiver")
  fuelRefuelRequestsRequested             FuelRefuelRequest[] @relation("FuelRefuelRequester")
  fuelRefuelRequestsManagerApproved       FuelRefuelRequest[] @relation("FuelRefuelManager")
  fuelRefuelRequestsSuppliesApproved      FuelRefuelRequest[] @relation("FuelRefuelSupplies")
  vehicleReservationsCreated              VehicleReservation[] @relation("VehicleReservationCreator")
  vehicleReservationsSuppliesApproved     VehicleReservation[] @relation("VehicleReservationSuppliesApprover")
  logisticsDeliveryRequestsCreated        LogisticsDeliveryRequest[] @relation("LogisticsDeliveryCreator")
  logisticsDeliveryCompletionsReported    LogisticsDeliveryCompletion[] @relation("LogisticsDeliveryCompleter")
  vehicleReservationsBaixaReported        VehicleReservation[] @relation("VehicleReservationBaixaReporter")
  vehicleReservationsVistoriaReported     VehicleReservation[] @relation("VehicleReservationVistoriaReporter")
  fluigWorkflowApproverViewers            FluigWorkflowApproverViewer[] @relation("FluigApproverViewerUser")
  updatedFluigWorkflowApproverViewers     FluigWorkflowApproverViewer[] @relation("FluigApproverViewerUpdatedBy")
  flowDiagrams                            FlowDiagram[]        @relation("FlowDiagramOwner")
  licitacoesCreated                       Licitacao[]          @relation("LicitacaoCreator")
  asoRegistrosCreated                     AsoRegistro[]        @relation("AsoRegistroCreator")
  toolRentalRequestsCreated               ToolRentalRequest[]  @relation("ToolRentalRequestCreator")
  toolRentalRequestsAssigned              ToolRentalRequest[]  @relation("ToolRentalRequestAssignedUser")
  toolRentalRequestsSuppliesApproved      ToolRentalRequest[]  @relation("ToolRentalRequestSuppliesApprover")
  toolRentalRequestEvents                 ToolRentalRequestEvent[] @relation("ToolRentalRequestEventActor")
  materialRequestComments                 MaterialRequestComment[] @relation("MaterialRequestCommentAuthor")
  purchaseOrderComments                   PurchaseOrderComment[] @relation("PurchaseOrderCommentAuthor")
  gestaoOsWorkOrdersRequested             GestaoOsWorkOrder[]  @relation("GestaoOsRequester")
  gestaoOsWorkOrdersAssigned              GestaoOsWorkOrder[]  @relation("GestaoOsAssignee")
  gestaoOsWorkOrderEvents                 GestaoOsWorkOrderEvent[] @relation("GestaoOsEventActor")
  gestaoOsWorkOrderComments               GestaoOsWorkOrderComment[] @relation("GestaoOsCommentAuthor")
  gestaoOsMemberships                     GestaoOsMembership[] @relation("GestaoOsMembershipUser")
  gestaoOsPlansAssigned                   GestaoOsMaintenancePlan[] @relation("GestaoOsPlanAssignee")
  gestaoOsDocumentsUploaded               GestaoOsDocument[] @relation("GestaoOsDocumentUploader")
  helpTutorialsCreated                    HelpTutorial[]     @relation("HelpTutorialCreator")

  @@map("users")
}

// Modelo de FuncionÃ¡rio
model Employee {
  id                    String    @id @default(cuid())
  userId                String    @unique
  employeeId            String    @unique // MatrÃ­cula
  department            String
  position              String
  hireDate              DateTime
  birthDate             DateTime? // Data de nascimento para aniversÃ¡rios
  salary                Decimal   @db.Decimal(10, 2)
  workSchedule          Json // HorÃ¡rio de trabalho em JSON
  isRemote              Boolean   @default(false)
  allowedLocations      Json? // Locais permitidos para bater ponto
  costCenter            String? // Centro de custo
  client                String? // Tomador
  dailyFoodVoucher      Float?    @default(33.40) // Vale AlimentaÃ§Ã£o diÃ¡rio (padrÃ£o R$ 33,40)
  dailyTransportVoucher Float?    @default(11.00) // Vale Transporte diÃ¡rio (padrÃ£o R$ 11,00)

  // Novos campos - Dados da Empresa
  company String? // EMPRESA

  // Novos campos - Dados BancÃ¡rios
  bank        String? // BANCO
  accountType String? // TIPO DE CONTA
  agency      String? // AGÃNCIA
  operation   String? // OP.
  account     String? // CONTA
  digit       String? // DIGITO

  // Novos campos - Dados PIX
  pixKeyType String? // TIPO DE CHAVE
  pixKey     String? // CHAVE PIX

  // Novos campos - Modalidade e Adicionais
  modality     String? // MODALIDADE (MEI, CLT, ESTAGIARIO)
  familySalary Decimal? @db.Decimal(10, 2) // SALÃRIO FAMÃLIA
  dangerPay    Decimal? @db.Decimal(10, 2) // PERICULOSIDADE
  unhealthyPay Decimal? @db.Decimal(10, 2) // INSALUBRIDADE

  // Novos campos - Polo e Categoria Financeira
  polo                String? // POLO (BRASÃLIA, GOIÃS)
  categoriaFinanceira String? // CATEGORIA FINANCEIRA (CUSTO, DESPESA)

  // Campo para controlar se o funcionÃ¡rio precisa bater ponto
  requiresTimeClock Boolean @default(true) // Se false, nÃ£o precisa bater ponto

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeRecords             TimeRecord[]
  vacations               Vacation[]
  overtime                Overtime[]
  medicalCertificates     MedicalCertificate[]
  salaryAdjustments       SalaryAdjustment[]
  salaryDiscounts         SalaryDiscount[]
  pointCorrectionRequests PointCorrectionRequest[]
  dpRequests              DpRequest[]
  manualInssValues        ManualInssValue[]
  asoRegistros            AsoRegistro[]

  @@map("employees")
}

// Modelo de Registro de Ponto
model TimeRecord {
  id                     String         @id @default(cuid())
  userId                 String
  employeeId             String
  type                   TimeRecordType
  timestamp              DateTime       @default(now())
  latitude               Float?
  longitude              Float?
  photoUrl               String?
  photoKey               String? // Chave do S3
  isValid                Boolean        @default(true)
  reason                 String? // Motivo se invÃ¡lido
  observation            String? // ObservaÃ§Ã£o do funcionÃ¡rio
  approvedBy             String? // ID do aprovador
  approvedAt             DateTime?
  foodVoucherAmount      Float?         @default(0) // Valor do VA no dia
  transportVoucherAmount Float?         @default(0) // Valor do VT no dia
  costCenter             String? // Centro de custo do funcionÃ¡rio no momento do ponto
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  // Relacionamentos
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("time_records")
}

// Modelo de FÃ©rias
model Vacation {
  id         String @id @default(cuid())
  userId     String
  employeeId String

  // PerÃ­odo das fÃ©rias
  startDate DateTime
  endDate   DateTime
  days      Int

  // ClassificaÃ§Ã£o
  type     VacationType   @default(ANNUAL)
  status   VacationStatus @default(PENDING)
  fraction Int? // NÃºmero do fracionamento (1, 2, 3)

  // PerÃ­odo aquisitivo
  aquisitiveStart DateTime // InÃ­cio do perÃ­odo aquisitivo
  aquisitiveEnd   DateTime // Fim do perÃ­odo aquisitivo
  concessiveEnd   DateTime // Vencimento das fÃ©rias

  // DocumentaÃ§Ã£o
  noticeSentAt     DateTime? // Data do aviso
  noticeReceivedAt DateTime? // Data da confirmaÃ§Ã£o
  paymentDate      DateTime? // Data do pagamento
  paymentAmount    Decimal?  @db.Decimal(10, 2)

  // AprovaÃ§Ã£o
  reason     String?
  approvedBy String?
  approvedAt DateTime?

  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("vacations")
}

// Modelo de Horas Extras
model Overtime {
  id          String         @id @default(cuid())
  userId      String
  employeeId  String
  date        DateTime
  hours       Decimal        @db.Decimal(4, 2)
  type        OvertimeType
  description String?
  status      OvertimeStatus @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relacionamentos
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("overtime")
}

// Modelo de RelatÃ³rios
model Report {
  id          String       @id @default(cuid())
  userId      String
  type        ReportType
  title       String
  description String?
  data        Json // Dados do relatÃ³rio em JSON
  period      Json // PerÃ­odo do relatÃ³rio
  status      ReportStatus @default(GENERATED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relacionamentos
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reports")
}

// Modelo de ConfiguraÃ§Ãµes da Empresa
model CompanySettings {
  id                  String   @id @default(cuid())
  name                String
  cnpj                String   @unique
  address             String
  phone               String?
  email               String?
  workStartTime       String   @default("07:00")
  workEndTime         String   @default("17:00")
  lunchStartTime      String   @default("12:00")
  lunchEndTime        String   @default("13:00")
  toleranceMinutes    Int      @default(10)
  maxOvertimeHours    Int      @default(2)
  maxDistanceMeters   Int      @default(1000)
  defaultLatitude     Float    @default(-23.5505)
  defaultLongitude    Float    @default(-46.6333)
  vacationDaysPerYear Int      @default(30)
  /// Prazo informado ao solicitante de combustÃ­vel (horas Ãºteis atÃ© atendimento do Suprimentos)
  fuelSuppliesSlaHours Int     @default(24)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("company_settings")
}

// Modelo de Logs de Auditoria
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  summary   String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, createdAt])
  @@map("audit_logs")
}

/// HistÃ³rico de logins / logouts (web / mobile)
model UserLoginEvent {
  id        String   @id @default(cuid())
  userId    String
  /// login | logout
  type      String   @default("login")
  success   Boolean  @default(true)
  source    String?  // web | mobile
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("user_login_events")
}

/// PÃ¡ginas visitadas no sistema (web)
model UserPageVisit {
  id        String   @id @default(cuid())
  userId    String
  path      String
  label     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, path, createdAt])
  @@map("user_page_visits")
}

