}

/// TÃ³pico dentro de uma conversa (estilo threads do ChatGPT)
model ChatTopic {
  id            String    @id @default(cuid())
  chatId        String
  title         String
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?
  isPinned      Boolean   @default(false)
