/// Repasses Gennesis por consórcio (seção BSB/HUB na planilha).
model RepasseFinanceiro {
  id            String   @id @default(cuid())
  consorcio     String // bsb | hub
  fornecedor    String
  parcela       String
  dataEmissao   String?
  boleto        String?
  data          String?
  valorOriginal Decimal  @db.Decimal(15, 2)
  oc            String?
  valorFinal    Decimal  @db.Decimal(15, 2)
  pagamento     String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([consorcio])
  @@index([fornecedor])
  @@map("repasses_financeiros")
}

/// Espelho local de contratações PNCP (ingestão por keywords, janela recente).
model PncpContratacao {
  id                       String    @id @default(cuid())
  numeroControlePNCP       String    @unique
  sequencialCompra         Int?
  processo                 String?
  // Numero da contratacao/pregao no sistema de origem (API PNCP: numeroCompra).
  numeroCompra             String?
  objeto                   String?   @db.Text
  objetoNorm               String?   @db.Text
  orgao                    String?
  cnpjOrgao                String?
  unidadeCompradora        String?
  codigoUnidadeCompradora  String?
  uf                       String
  municipio                String?
  modalidade               String?
  codigoModalidade         Int
  situacao                 String?
  modoDisputa              String?
  plataforma               String?
  srp                      Boolean?
  valorEstimado            Float?
  valorHomologado          Float?
  dataInclusao             DateTime?
  dataAberturaProposta     DateTime?
  dataEncerramentoProposta DateTime?
  amparoLegal              String?   @db.Text
  linkSistemaOrigem        String?
  linkPncp                 String?
  syncedAt                 DateTime  @default(now())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([uf])
  @@index([codigoModalidade])
  @@index([dataInclusao])
  @@index([uf, codigoModalidade, dataInclusao])
  @@index([syncedAt])
  @@map("pncp_contratacoes")
}

/// Histórico / status das sincronizações PNCP → banco local.
model PncpSyncRun {
  id            String    @id @default(cuid())
  status        String // running | success | partial | failed
  trigger       String // cron | manual
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  lookbackDays  Int
  pagesFetched  Int       @default(0)
  upserted      Int       @default(0)
  pruned        Int       @default(0)
  rateLimitHits Int       @default(0)
  errorMessage  String?   @db.Text
  createdAt     DateTime  @default(now())

  @@index([startedAt])
  @@index([status])
  @@map("pncp_sync_runs")
}

/// Estado de sincronização por UF (incremental + retry de erros).
model PncpSyncUfState {
  uf               String    @id
  lastSuccessAt    DateTime?
  lastAttemptAt    DateTime?
  lastDataFinal    String?
  lastStatus       String    @default("pending") // success | error | pending
  lastErrorMessage String?   @db.Text
  lastRunId        String?
  updatedAt        DateTime  @updatedAt

  @@index([lastStatus])
  @@index([lastSuccessAt])
  @@map("pncp_sync_uf_states")
}

// ─── Segurança do Trabalho / ASO ─────────────────────────────────────────────

enum AsoGrauRisco {
  BAIXO
  MEDIO
  ALTO
}

enum AsoResultado {
  APTO
  APTO_COM_RESTRICAO
  INAPTO
}

/// Tipos de ASO (Admissional, Periódico, etc.)
model AsoTipo {
  id          String   @id @default(cuid())
  nome        String   @unique
  /// Preço padrão sugerido ao cadastrar ASO deste tipo (R$)
  valorPadrao Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registros AsoRegistro[]

  @@map("tipos_aso")
}

/// Periodicidade do ASO periódico por cargo + setor (Employee.position + department)
model CargoRisco {
  id                  String       @id @default(cuid())
  cargo               String
  setor               String
  grauRisco           AsoGrauRisco @default(MEDIO)
  periodicidadeMeses  Int
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([cargo, setor])
  @@index([cargo])
  @@index([setor])
  @@map("cargos_risco")
}

/// Registro de ASO vinculado a um funcionário
model AsoRegistro {
  id                String       @id @default(cuid())
  funcionarioId     String
  tipoAsoId         String
  dataExame         DateTime     @db.Date
  dataValidade      DateTime     @db.Date
  resultado         AsoResultado
  medicoResponsavel String
  crmMedico         String
  clinica           String
  /// Valor cobrado / pago pelo exame (R$)
  valor             Decimal?     @db.Decimal(12, 2)
  anexoUrl          String?
  observacoes       String?      @db.Text
  /// true quando a validade usou 12 meses padrão (cargo sem cargos_risco)
  validadePadrao    Boolean      @default(false)
  periodicidadeUsada Int
  criadoPorId       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  funcionario Employee @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  tipoAso     AsoTipo  @relation(fields: [tipoAsoId], references: [id], onDelete: Restrict)
  criadoPor   User?    @relation("AsoRegistroCreator", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([funcionarioId])
  @@index([tipoAsoId])
  @@index([dataValidade])
  @@index([resultado])
  @@index([createdAt])
  @@map("aso_registros")
}

enum ToolRentalDemandType {
  NOVA_LOCACAO
  RENOVACAO
  DEVOLUCAO
  COMPRA
}

enum ToolRentalPriority {
  NORMAL
  URGENT
}

enum ToolRentalLogisticsMode {
  ENTREGA_LOGISTICA
  RETIRADA_LOGISTICA
  ENTREGA_FORNECEDOR
  RETIRADA_FORNECEDOR
}

enum ToolRentalRequestStatus {
  OPEN
  SUPPLIER_RELATION
  AWAITING_PAYMENT
  COMPLETED
  REJECTED
  CANCELLED
}

/// Solicitações de ferramentas (Engenharia → fluxo Suprimentos até pagamento)
model ToolRentalRequest {
  id                      String                    @id @default(cuid())
  code                    String                    @unique
  polo                    String
  contrato                String
  obra                    String
  titulo                  String
  assignedUserId          String
  supplierId              String?
  supplierName            String?
  priority                ToolRentalPriority        @default(NORMAL)
  logisticsMode           ToolRentalLogisticsMode
  demandType              ToolRentalDemandType
  equipamento             String
  periodoInicio           DateTime                  @db.Date
  periodoFim              DateTime                  @db.Date
  linkSugestao            String?
  status                  ToolRentalRequestStatus   @default(OPEN)
  ocMirrorUrl             String?
  ocMirrorName            String?
  paymentProofUrl         String?
  paymentProofName        String?
  suppliesApprovedById    String?
  suppliesApprovedAt      DateTime?
  suppliesApprovalComment String?
  suppliesRejectionReason String?
  createdById             String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  assignedUser       User      @relation("ToolRentalRequestAssignedUser", fields: [assignedUserId], references: [id], onDelete: Restrict)
  createdBy          User?     @relation("ToolRentalRequestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  suppliesApprovedBy User?     @relation("ToolRentalRequestSuppliesApprover", fields: [suppliesApprovedById], references: [id], onDelete: SetNull)
  supplier           Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  events             ToolRentalRequestEvent[]

  @@index([status])
  @@index([createdById])
  @@index([assignedUserId])
  @@index([createdAt])
  @@map("tool_rental_requests")
}

/// Histórico de etapas da solicitação de ferramentas (timeline)
model ToolRentalRequestEvent {
  id         String                   @id @default(cuid())
  requestId  String
  fromStatus ToolRentalRequestStatus?
  toStatus   ToolRentalRequestStatus
  note       String?
  actorId    String?
  createdAt  DateTime                 @default(now())

  request ToolRentalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?             @relation("ToolRentalRequestEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@map("tool_rental_request_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// Sistema de Gestão - OS (manutenção predial / patrimonial)
// ─────────────────────────────────────────────────────────────────────────────

enum GestaoOsPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum GestaoOsMaintenanceType {
  CORRECTIVE
  PREVENTIVE
  PREDICTIVE
}

enum GestaoOsStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  SAFETY_CHECK
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  REWORK
  CLOSED
  CANCELLED
}

/// Perfis de acesso no módulo Gestao OS (por empresa).
enum GestaoOsProfile {
  REQUESTER
  MANAGER
  TECHNICIAN
  ADMIN
}

/// Configurações gerais do módulo Gestão de OS (ex.: numeração).
model GestaoOsSettings {
  id           String   @id @default("default")
  /// Próximo número mínimo a usar na numeração das OS (não afeta número do chamado).
  nextOsNumber Int      @default(1)
  /// true após migração que separou sequência de chamado da de OS.
  chamadoSeqSeparated Boolean @default(false)
  updatedAt    DateTime @updatedAt

  @@map("gestao_os_settings")
}

/// Empresa (tenant) — base multi-empresa simples.
model GestaoOsCompany {
  id        String   @id @default(cuid())
  name      String
  tradeName String?
  document  String?
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches   GestaoOsBranch[]
  buildings  GestaoOsBuilding[]
  providers  GestaoOsProvider[]
  categories GestaoOsServiceCategory[]
  members    GestaoOsMembership[]
  workOrders GestaoOsWorkOrder[]
  plans      GestaoOsMaintenancePlan[]
  checklists GestaoOsChecklistTemplate[]
  documents  GestaoOsDocument[]

  @@index([name])
  @@index([document])
  @@map("gestao_os_companies")
}

/// Filial da empresa.
model GestaoOsBranch {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   GestaoOsCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  buildings GestaoOsBuilding[]

  @@index([companyId])
  @@index([name])
  @@map("gestao_os_branches")
}

/// Prestador de serviço / fornecedor de manutenção.
model GestaoOsProvider {
  id          String   @id @default(cuid())
  companyId   String?
  name        String
  document    String?
  specialty   String?
  contactName String?
  phone       String?
  email       String?
  notes       String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    GestaoOsCompany?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  workOrders GestaoOsWorkOrder[]

  @@index([companyId])
  @@index([name])
  @@index([document])
  @@map("gestao_os_providers")
}

/// Tipo / categoria de serviço (elétrica, hidráulica, etc.).
model GestaoOsServiceCategory {
  id          String   @id @default(cuid())
  companyId   String?
  name        String
  code        String?
  description String?
  /// Template de checklist copiado para a OS na abertura (por tipo de serviço).
  checklistId String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company GestaoOsCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([name])
  @@unique([companyId, name])
  @@map("gestao_os_service_categories")
}

/// Vínculo usuário ↔ empresa + perfil no Gestao OS.
model GestaoOsMembership {
  id        String         @id @default(cuid())
  companyId String
  userId    String
  profile   GestaoOsProfile @default(REQUESTER)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  company GestaoOsCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User            @relation("GestaoOsMembershipUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([profile])
  @@map("gestao_os_memberships")
}

/// Prédio / edifício da hierarquia de locais.
model GestaoOsBuilding {
  id        String   @id @default(cuid())
  companyId String?
  branchId  String?
  name      String
  code      String?
  address   String?
  latitude  Float?
  longitude Float?
  responsibleUserId String?
  prepostoUserId    String?
  managerUserId     String?
  fiscalUserId      String?
  qrToken   String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    GestaoOsCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  branch     GestaoOsBranch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sectors    GestaoOsSector[]
  workOrders GestaoOsWorkOrder[]
  plans      GestaoOsMaintenancePlan[]
  documents  GestaoOsDocument[]

  @@index([companyId])
  @@index([branchId])
  @@index([name])
  @@map("gestao_os_buildings")
}

/// Andar / Setor dentro de um prédio.
model GestaoOsSector {
  id         String   @id @default(cuid())
  buildingId String
  name       String
  code       String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  building   GestaoOsBuilding @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  places     GestaoOsPlace[]
  workOrders GestaoOsWorkOrder[]

  @@index([buildingId])
  @@index([name])
  @@map("gestao_os_sectors")
}

/// Sala / Local dentro de um setor.
model GestaoOsPlace {
  id        String   @id @default(cuid())
  sectorId  String
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sector     GestaoOsSector @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  assets     GestaoOsAsset[]
  workOrders GestaoOsWorkOrder[]

  @@index([sectorId])
  @@index([name])
  @@map("gestao_os_places")
}

/// Ativo / equipamento vinculado a um local (com QR Code).
model GestaoOsAsset {
  id        String   @id @default(cuid())
  placeId   String
  name      String
  code      String?
  category  String?
  serialNumber String?
  /// Token estável usado no QR Code do ativo.
  qrToken   String   @unique
  /// Fim da garantia do ativo (alerta no sino antes de vencer).
  warrantyEndsAt DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  place      GestaoOsPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)
  workOrders GestaoOsWorkOrder[]
  plans      GestaoOsMaintenancePlan[]
  documents  GestaoOsDocument[]

  @@index([placeId])
  @@index([name])
  @@map("gestao_os_assets")
}

/// Grupo de equipamento (catálogo Sispred: CIVIL, ELÉTRICA, etc.).
model GestaoOsEquipmentGroup {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subgroups GestaoOsEquipmentSubgroup[]

  @@index([name])
  @@map("gestao_os_equipment_groups")
}

/// Subgrupo de equipamento, vinculado a um grupo.
model GestaoOsEquipmentSubgroup {
  id        String   @id @default(cuid())
  groupId   String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group      GestaoOsEquipmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  equipments GestaoOsEquipment[]

  @@index([groupId])
  @@index([name])
  @@map("gestao_os_equipment_subgroups")
}

/// Equipamento do catálogo (não é o ativo físico do local).
model GestaoOsEquipment {
  id                String   @id @default(cuid())
  subgroupId        String
  name              String
  manufacturer      String?
  model             String?
  /// SLA padrão em horas. Null = nenhum.
  defaultSlaHours   Int?
  /// Expectativa de vida útil em anos.
  expectedLifeYears Int?
  notes             String?  @db.Text
  /// Anexos: [{ url, name, mimeType?, kind? }] — kind: MANUAL | WARRANTY | LAUDO | OTHER
  attachments       Json?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subgroup GestaoOsEquipmentSubgroup @relation(fields: [subgroupId], references: [id], onDelete: Cascade)

  @@index([subgroupId])
  @@index([name])
  @@map("gestao_os_equipments")
}

/// Ordem de serviço / chamado de manutenção predial.
model GestaoOsWorkOrder {
  id            String @id @default(cuid())
  /// Número do chamado (sempre gerado na abertura).
  displayNumber Int    @unique
  /// Número da OS — gerado na primeira análise (Em Análise). Null = ainda só chamado.
  osNumber      Int?   @unique
  companyId     String?

  status           GestaoOsStatus          @default(OPEN)
  priority         GestaoOsPriority        @default(MEDIUM)
  maintenanceType  GestaoOsMaintenanceType?
  category         String
  description      String                  @db.Text

  buildingId String?
  sectorId   String?
  placeId    String?
  assetId    String?
  providerId String?

  company  GestaoOsCompany?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  building GestaoOsBuilding? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  sector   GestaoOsSector?   @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  place    GestaoOsPlace?    @relation(fields: [placeId], references: [id], onDelete: SetNull)
  asset    GestaoOsAsset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  provider GestaoOsProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  /// Snapshot textual do local (cascata) no momento da abertura.
  locationLabel String?

  requesterId String
  requester   User   @relation("GestaoOsRequester", fields: [requesterId], references: [id], onDelete: Restrict)

  assigneeId String?
  assignee   User?   @relation("GestaoOsAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// Nome livre da empresa prestadora (quando não for cadastro).
  providerName String?

  /// Anexos: [{ url, name, mimeType? }]
  attachments Json?

  cancelReason   String? @db.Text
  completionNote String? @db.Text
  rating         Int?
  ratingComment  String? @db.Text
  /// REQUEST | SAC | UNPLANNED | PLANTAO
  origin         String  @default("REQUEST")
  /// CHAMADO | DUVIDA | RECLAMACAO (quando origin = SAC)
  sacKind        String?
  teamUserIds    Json?
  fiscalRating        Int?
  fiscalRatingComment String? @db.Text
  fiscalUserId        String?
  attestedAt          DateTime?
  closeQrVerifiedAt   DateTime?

  /// Prazo / SLA da OS.
  dueAt DateTime?
  /// Horas de SLA aplicadas na abertura/aprovação (auditoria).
  slaHoursApplied Int?
  /// Quando o alerta pré-estouro de SLA foi enviado.
  slaWarnedAt DateTime?
  /// Peças/custos: [{ id, name, supplier, quantity, unitCost, expectedAt, notes }]
  parts Json?
  /// Chamado/OS relacionado (reincidência).
  relatedWorkOrderId String?
  relatedWorkOrder   GestaoOsWorkOrder?  @relation("GestaoOsRelated", fields: [relatedWorkOrderId], references: [id], onDelete: SetNull)
  relatedFrom        GestaoOsWorkOrder[] @relation("GestaoOsRelated")
  /// Foto no início da execução (campo).
  startPhotoUrl String?
  /// Foto no fim da execução (campo).
  endPhotoUrl   String?
  /// Respostas de checklist preenchidas na execução [{ id, label, checked, note? }].
  checklistResponses Json?
  /// Checklist de segurança do trabalho (EPIs) antes da execução.
  safetyChecklistResponses Json?
  /// Foto da pessoa usando os EPIs, exigida na etapa Segurança do Trabalho.
  safetyPhotoUrl String?
  signatureRequesterUrl  String?
  signatureTechnicianUrl String?

  openedAt     DateTime  @default(now())
  approvedAt   DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  /// Tempo efetivo de execução em milissegundos (pausa em Aguardando peça).
  executionMs  Int       @default(0)
  /// Quando o relógio de execução foi retomado (status Em Execução).
  lastExecutionResumeAt DateTime?
  closedAt     DateTime?
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events   GestaoOsWorkOrderEvent[]
  comments GestaoOsWorkOrderComment[]
  planRuns GestaoOsPlanRun[]

  @@index([status])
  @@index([priority])
  @@index([companyId])
  @@index([requesterId])
  @@index([assigneeId])
  @@index([buildingId])
  @@index([providerId])
  @@index([openedAt])
  @@index([dueAt])
  @@index([relatedWorkOrderId])
  @@index([assetId])
  @@map("gestao_os_work_orders")
}

model GestaoOsWorkOrderEvent {
  id          String         @id @default(cuid())
  workOrderId String
  fromStatus  GestaoOsStatus?
  toStatus    GestaoOsStatus
  note        String?        @db.Text
  actorId     String?
  createdAt   DateTime       @default(now())

  workOrder GestaoOsWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  actor     User?             @relation("GestaoOsEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workOrderId, createdAt])
  @@map("gestao_os_work_order_events")
}

model GestaoOsWorkOrderComment {
  id          String   @id @default(cuid())
  workOrderId String
  userId      String
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workOrder GestaoOsWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  author    User              @relation("GestaoOsCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([userId])
  @@map("gestao_os_work_order_comments")
}

enum GestaoOsPlanType {
  PREVENTIVE
  PMOC
  SAFETY
}

/// Template de checklist reutilizável (preventiva / PMOC / SST).
model GestaoOsChecklistTemplate {
  id          String          @id @default(cuid())
  companyId   String?
  name        String
  planType    GestaoOsPlanType @default(PREVENTIVE)
  category    String?
  /// Itens: [{ id, label, required? }]
  items       Json
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  company GestaoOsCompany?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  plans   GestaoOsMaintenancePlan[]

  @@index([companyId])
  @@index([planType])
  @@map("gestao_os_checklist_templates")
}

/// Plano de manutenção preventiva / PMOC / segurança.
model GestaoOsMaintenancePlan {
  id              String          @id @default(cuid())
  companyId       String
  name            String
  planType        GestaoOsPlanType @default(PREVENTIVE)
  description     String?         @db.Text
  category        String?
  buildingId      String?
  assetId         String?
  checklistId     String?
  /// Intervalo em dias entre gerações (ex.: 30, 90, 180).
  intervalDays    Int             @default(30)
  nextDueAt       DateTime
  lastGeneratedAt DateTime?
  assigneeId      String?
  /// Horário previsto da OS (HH:mm).
  scheduledTime   String?
  /// IDs dos técnicos na ordem do rodízio.
  technicianIds   Json            @default("[]")
  rotateTechnicians Boolean       @default(false)
  rotationIndex   Int             @default(0)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company   GestaoOsCompany            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  building  GestaoOsBuilding?          @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  asset     GestaoOsAsset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)
  checklist GestaoOsChecklistTemplate? @relation(fields: [checklistId], references: [id], onDelete: SetNull)
  assignee  User?                      @relation("GestaoOsPlanAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  runs      GestaoOsPlanRun[]

  @@index([companyId])
  @@index([planType])
  @@index([nextDueAt])
  @@index([isActive])
  @@map("gestao_os_maintenance_plans")
}

model GestaoOsPlanRun {
  id          String   @id @default(cuid())
  planId      String
  workOrderId String?
  dueAt       DateTime
  generatedAt DateTime @default(now())

  plan      GestaoOsMaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  workOrder GestaoOsWorkOrder?      @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([planId])
  @@index([workOrderId])
  @@map("gestao_os_plan_runs")
}

enum GestaoOsDocumentKind {
  MANUAL
  WARRANTY
  LAUDO
  ART
  CHECKLIST_IFSP
  MANUAL_PATRIMONIO
  OTHER
}

/// Repositório de documentos por empresa / prédio / ativo.
model GestaoOsDocument {
  id          String              @id @default(cuid())
  companyId   String
  buildingId  String?
  assetId     String?
  kind        GestaoOsDocumentKind @default(OTHER)
  title       String
  fileUrl     String
  fileName    String?
  mimeType    String?
  notes       String?             @db.Text
  uploadedById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  company    GestaoOsCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  building   GestaoOsBuilding? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  asset      GestaoOsAsset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  uploadedBy User?             @relation("GestaoOsDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([buildingId])
  @@index([assetId])
  @@index([kind])
  @@map("gestao_os_documents")
}
