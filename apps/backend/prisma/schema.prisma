}

enum FuelRefuelDeadlineUnit {
  HOURS
  DAYS
}

/// Região administrativa para abastecimento (cidade satélite / local de origem da rota).
model FuelAdministrativeRegion {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  /// UF de abastecimento (ex.: DF, GO)
  stateCode String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
