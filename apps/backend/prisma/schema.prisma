  @@index([numeroProcesso])
  @@index([reclamante])
  @@index([status])
  @@index([statusProcesso])
  @@index([empresa])
  @@map("juridico_processos")
}

model JuridicoProcessoAnexo {
  id           String           @id @default(cuid())
  processoId   String
  processo     JuridicoProcesso @relation(fields: [processoId], references: [id], onDelete: Cascade)
  externalId   String?
  originalName String
  sourcePath   String?
  fileUrl      String?
  fileKey      String?
  mimeType     String?
  size         Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([processoId])
  @@index([externalId])
  @@map("juridico_processo_anexos")
}

model JuridicoProcessoComprovante {
  id            String           @id @default(cuid())
  processoId    String
  processo      JuridicoProcesso @relation(fields: [processoId], references: [id], onDelete: Cascade)
  externalId    String?
  originalName  String
  sourcePath    String?
  dataPagamento String?
  fileUrl       String?
  fileKey       String?
  mimeType      String?
  size          Int?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([processoId])
  @@index([externalId])
  @@map("juridico_processo_comprovantes")
}
